{
  "Name": "Pear Desktop Stream Deck Plugin",
  "Author": "PixelPulseDev",
  "Description": "Control Pear Desktop Music Player from Stream Deck.",
  "URL": "https://github.com/PixelPulseDev/pear-desktop-streamdeck",
  "UUID": "com.pear.desktop.streamdeck",
  "Icon": "icons/action-image",
  "Version": "1.0.0",
  "Category": "Pear Desktop Stream Deck Plugin",
  "CategoryIcon": "icons/category-icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.11"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Icon": "icons/music-play",
      "Name": "Play-Pause",
      "States": [
        {
          "Image": "icons/music-pause",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/music-play",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": false,
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Seek track position",
          "Push": "Plays or pauses the current song"
        }
      },
      "SupportedInMultiActions": true,
      "Tooltip": "Plays or Pauses the current song",
      "UUID": "com.pear.desktop.streamdeck.play-pause"
    },
    {
      "Icon": "icons/music-next",
      "Name": "Next",
      "States": [
        {
          "Image": "icons/music-next",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Go to next song",
      "UUID": "com.pear.desktop.streamdeck.next"
    },
    {
      "Icon": "icons/music-prev",
      "Name": "Prev",
      "States": [
        {
          "Image": "icons/music-prev",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Go to prev song",
      "UUID": "com.pear.desktop.streamdeck.prev"
    },
    {
      "Icon": "icons/like-on",
      "Name": "Like",
      "States": [
        {
          "Image": "icons/like-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/like-off",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Likes current song",
      "UUID": "com.pear.desktop.streamdeck.like"
    },
    {
      "Icon": "icons/dislike-on",
      "Name": "Dislike",
      "States": [
        {
          "Image": "icons/dislike-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/dislike-off",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Dislikes current song",
      "UUID": "com.pear.desktop.streamdeck.dislike"
    },
    {
      "Icon": "icons/volume-on",
      "Name": "Mute",
      "States": [
        {
          "Image": "icons/volume-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/volume-mute",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Mutes / unmutes volume",
      "UUID": "com.pear.desktop.streamdeck.mute"
    },
    {
      "Icon": "icons/volume-down",
      "Name": "Volume Down",
      "States": [
        {
          "Image": "icons/volume-down",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Volume Down",
      "UUID": "com.pear.desktop.streamdeck.volume-down"
    },
    {
      "Icon": "icons/volume-up",
      "Name": "Volume Up",
      "States": [
        {
          "Image": "icons/volume-up",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": false,
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Volume control",
          "Push": "Mute"
        }
      },
      "SupportedInMultiActions": true,
      "Tooltip": "Volume Up",
      "UUID": "com.pear.desktop.streamdeck.volume-up"
    },
    {
      "Icon": "icons/action-image",
      "Name": "Track Info",
      "States": [
        {
          "Image": "icons/action-image",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "FontFamily": "Courier New",
          "FontStyle": "Bold"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Track Title and Thumbnail",
      "UUID": "com.pear.desktop.streamdeck.song-info"
    },
    {
      "Icon": "icons/shuffle",
      "Name": "Shuffle",
      "States": [
        {
          "Image": "icons/shuffle"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Shuffle",
      "UUID": "com.pear.desktop.streamdeck.shuffle"
    },
    {
      "Icon": "icons/repeat",
      "Name": "Repeat",
      "States": [
        {
          "Image": "icons/repeat"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Repeat",
      "UUID": "com.pear.desktop.streamdeck.repeat"
    },
    {
      "Icon": "icons/music-play",
      "Name": "Play Playlist",
      "States": [
        {
          "Image": "icons/music-play",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Play a selected playlist",
      "UUID": "com.pear.desktop.streamdeck.play-playlist"
    }
  ],
  "CodePath": "action.html",
  "PropertyInspectorPath": "property-inspector.html"
}
